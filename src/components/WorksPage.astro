---
import Layout from '../layouts/Layout.astro';
import BackLink from './BackLink.astro';
import WorkCard from './WorkCard.astro';
import VideoModal from './VideoModal.astro';
import { works } from '../data/works';

interface Props {
  lang: 'fr' | 'en';
  backHref: string;
  title: string;
  metaTitle?: string;
  description: string;
  viewWorkLabel: string;
  likeLabel: string;
  modalLabel: string;
  closeLabel: string;
  backLabel: string;
}

const { lang, backHref, title, metaTitle, description, viewWorkLabel, likeLabel, modalLabel, closeLabel, backLabel } = Astro.props;
---

<Layout title={metaTitle ?? title} description={description} lang={lang}>
  <main class="works-page">
    <div class="container">
      <header class="works-page-header">
        <BackLink href={backHref} label={backLabel} />
        <h1 class="works-page-title">{title}</h1>
      </header>

      <div class="works-grid">
        {works.map((work, index) => (
          <WorkCard
            id={work.id}
            title={work.title[lang]}
            description={work.description[lang]}
            thumbnail={work.thumbnail}
            video={work.video}
            externalUrl={work.externalUrl}
            year={work.year}
            index={index}
            viewWorkLabel={viewWorkLabel}
            likeLabel={likeLabel}
            detailHref={`${lang === 'fr' ? '' : '/en'}/works/${work.id}`}
          />
        ))}
      </div>
    </div>

    <VideoModal likeLabel={likeLabel} modalLabel={modalLabel} closeLabel={closeLabel} />
  </main>
</Layout>

<style>
  .works-page {
    min-height: 100vh;
    background: var(--color-bg);
    padding-top: var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-md);
  }

  .works-page-header {
    margin-bottom: var(--space-xl);
  }

  .works-page-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    color: var(--color-text);
    font-weight: 400;
  }

  .works-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: var(--space-md);
  }

  @media (min-width: 768px) {
    .works-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-lg);
    }
  }
</style>
